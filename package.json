{
  "name": "cairn-edge-studio",
  "productName": "Cairn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','release']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/assistantBrain.test.ts src/utils/edgeEngine.test.ts src/utils/markdownParser.test.ts src/utils/ollamaClient.test.ts src/utils/sceneRenderer.test.ts src/utils/wavEncoder.test.ts",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 3210 --strictPort\" \"wait-on http://127.0.0.1:3210 && electron electron/main.cjs\"",
    "build:desktop": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ntech.cairn",
    "productName": "Cairn",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cairn-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cairn",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
